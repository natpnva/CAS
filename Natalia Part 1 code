program project1

! Part I, basic version: isothermal gas in HE inside a NFW DM halo
! No BCG, no T(r) yet

! INDEX CONVENTION:
! r(j) nodes: r_j
! rr(j) half-points: r_{j+1/2} = r(j) + dr/2
! rho(j) lives at rr(j) (cell-centred density)
! vol(j) shell between r(j-1) and r(j); density is rho(j-1)
! m(j), grav(j) live at r(j) (enclosed mass, gravity)

implicit none

integer, parameter :: dp = kind(1.0d0)
integer, parameter :: jmax = 5000

! constants (cgs)
real(dp), parameter :: pi = 3.14159265358979324_dp
real(dp), parameter :: msol = 1.989d33            ! mass of the sun
real(dp), parameter :: kpc = 3.086d21             ! 1 kpc in cm
real(dp), parameter :: G = 6.672d-8               ! gravitational constant, cm^3/g/s^2
real(dp), parameter :: k_B = 1.380649d-16         ! Boltzmann constant, erg/K
real(dp), parameter :: m_p = 1.6726219d-24        ! proton mass, g
real(dp), parameter :: mu = 0.61_dp               ! mean molecular weight for fully ionized gas with primordial composition

! cluster parameters
real(dp), parameter :: rho0_dm = 7.35d-26         ! NFW density scale, g/cm^3
real(dp), parameter :: rs = 435.7_dp*kpc          ! NFW scale radius, cm
real(dp), parameter :: rvir = 2797.0_dp*kpc       ! virial radius, cm
real(dp), parameter :: tgas = 8.9d7               ! isothermal T, K
real(dp), parameter :: fb_target = 0.16_dp        ! cosmic baryon fraction

! BCG (Hernquist profile): M(r) = Mbcg r^2/(r+a)^2, half mass radius r_1/2= (1+sqrt2) a=12 kpc
real(dp), parameter :: mbcg = 1.0d12*msol                       ! total stellar mass of the BCG, g
real(dp), parameter :: abcg = 12.0_dp*kpc/(1.0_dp+sqrt(2.0_dp)) ! scale radius of the BCG, cm

! temperature profile
real(dp), parameter :: tmg = 8.9d7 ! K, also isothermal T
real(dp), parameter :: r500 = 1400.0_dp*kpc ! pretty much rvir/2

real(dp) :: r(jmax), rr(jmax), vol(jmax), &
            m_dm(jmax), m_an(jmax), m_star(jmax), m_zero(jmax), &
            mg_iso(jmax), mg_bcg(jmax), mg_full(jmax), &
            tem_iso(jmax), tem_r(jmax), &
            rho_dm(jmax), rho_iso(jmax), rho_bcg(jmax), rho_full(jmax), rho_an(jmax), &
            fbr(jmax), &
            rmin, rmax, dr, x, b, rho0_iso, rho0_bcg, rho0_full
! note that G is a constant and grav is an array
integer :: j, jv, iu, ios

! ---------------------------------------------------------------
! grid
! ---------------------------------------------------------------
rmin = 0.0_dp                       ! start at the origin
rmax = 3000.0_dp*kpc                ! end at 3 Mpc
dr = (rmax - rmin)/real(jmax-1, dp) ! grid spacing

do j = 1, jmax
   r(j)  = rmin + real(j-1, dp)*dr ! nodes
   rr(j) = r(j) + 0.5_dp*dr        ! half-points
end do

vol(1) = 4.0_dp*pi/3.0_dp*r(1)**3                  ! volume of first shell (r=0 to r(1))
do j = 2, jmax                                     ! start at j=2 because vol(1) is already set
   vol(j) = 4.0_dp*pi/3.0_dp*(r(j)**3 - r(j-1)**3) ! volume of shell between r(j-1) and r(j)
end do

jv = nint(rvir/dr) + 1 ! node closest to r_vir

! ---------------------------------------------------------------
! DM: density on rr, enclosed mass on r (num and an)
! ---------------------------------------------------------------
do j = 1, jmax
   x = rr(j)/rs                            ! dimensionless radius
   rho_dm(j) = rho0_dm/(x*(1.0_dp + x)**2) ! NFW density profile
end do

m_dm(1) = 0.0_dp ! valid because rmin = 0
do j = 2, jmax 
   m_dm(j) = m_dm(j-1) + rho_dm(j-1)*vol(j) ! cumulative mass of DM inside r(j)
end do

! ---------------------------------------------------------------
! analytic solution for comparison
! ---------------------------------------------------------------

do j=1, jmax
   x = r(j)/rs
   m_an(j) = 4.0_dp*pi*rho0_dm*rs**3*(log(1.0_dp + x) - x/(1.0_dp + x)) ! analytic cumulative mass of DM inside r(j)
end do

! ---------------------------------------------------------------
! BCG stellar mass on r 
! ---------------------------------------------------------------

do j=1,jmax
   m_star(j)=mbcg*r(j)**2/(r(j)+abcg)**2
end do
m_zero=0.0_dp ! no BCG for model A

! ---------------------------------------------------------------
! Temperature on rr: isothermal, and realistic T(r)
! ---------------------------------------------------------------

do j=1, jmax
   x=rr(j)/r500
   tem_iso(j)=tmg
   tem_r(j)=tmg*1.35_dp*((x/0.045_dp)**1.9_dp+0.45_dp)/((x/0.045_dp)**1.9_dp+1.0_dp)/(1.0_dp+(x/0.6_dp)**2)**0.45_dp
end do

! ---------------------------------------------------------------
! solve 3 models
! ---------------------------------------------------------------

call solve_hse(m_zero, tem_iso, rho_iso, mg_iso, rho0_iso) ! A = no BCG, isothermal
call solve_hse(m_star, tem_iso, rho_bcg, mg_bcg, rho0_bcg) ! B = BCG, isothermal
call solve_hse(m_star, tem_r, rho_full, mg_full, rho0_full) ! C = BCG, realistic T(r)

! analytic solution for model A
b = 8.0_dp*pi*G*mu*m_p*rho0_dm*rs**2/(27.0_dp*k_B*tmg)
do j = 1, jmax
   x = rr(j)/rs
   rho_an(j) = rho0_iso*exp(-13.5_dp*b*(1.0_dp - log(1.0_dp + x)/x))
end do

! baryon fraction profile of the final model, (M_* + M_gas)/M_tot
fbr(1)=0.0_dp
do j=2,jmax
   fbr(j)=(m_star(j)+mg_full(j))/(m_dm(j)+m_star(j)+mg_full(j))
end do 

! ---------------------------------------------------------------
! output
! ---------------------------------------------------------------
open(newunit=iu, file='part1.dat', status='replace', action='write', iostat=ios)
if (ios /= 0) stop 'could not open part1.dat'
write(iu,'(a)') '# r_half[kpc] rho_A_iso rho_A_analytic rho_DM rho_B_bcg rho_C_bcg_T T[K]'
do j = 1, jmax
   write(iu,'(7(1pe14.6))') rr(j)/kpc, rho_iso(j), rho_an(j), rho_dm(j), &
                            rho_bcg(j), rho_full(j), tem_r(j)
end do
close(iu)
 
open(newunit=iu, file='masse.dat', status='replace', action='write', iostat=ios)
if (ios /= 0) stop 'could not open masse.dat'
write(iu,'(a)') '# r[kpc] M_DM_numerical[Msun] M_DM_analytic[Msun] M_star[Msun] M_gas_C[Msun] f_b_C(r)'
do j = 1, jmax
   write(iu,'(6(1pe14.6))') r(j)/kpc, m_dm(j)/msol, m_an(j)/msol, m_star(j)/msol, &
                            mg_full(j)/msol, fbr(j)
end do
close(iu)
 
print *, 'dr [kpc] = ', dr/kpc
print *, 'a_BCG [kpc] = ', abcg/kpc
print *, 'M_DM(rvir) [Msun] = ', m_dm(jv)/msol, '  analytic: ', m_an(jv)/msol
print *, 'max rel. diff. M_DM numerical vs analytic (r > 10 kpc) = ', &
         maxval(abs(m_dm(nint(10.0_dp*kpc/dr)+1:jmax)/m_an(nint(10.0_dp*kpc/dr)+1:jmax) - 1.0_dp))
print *, 'model A: rho0 = ', rho0_iso,  '  f_b(rvir) = ', fbr_at(m_zero, mg_iso)
print *, 'model B: rho0 = ', rho0_bcg,  '  f_b(rvir) = ', fbr_at(m_star, mg_bcg)
print *, 'model C: rho0 = ', rho0_full, '  f_b(rvir) = ', fbr_at(m_star, mg_full)
print *, 'M_gas(rvir) model C [Msun] = ', mg_full(jv)/msol
print *, 'max |rho/rho_an - 1| model A = ', maxval(abs(rho_iso/rho_an - 1.0_dp))
 
contains
 
! ---------------------------------------------------------------
! Solve ln rho(j) = ln rho(j-1) - dr*grav(j)*mu*m_p/(k*Tmid) - [ln T(j) - ln T(j-1)]
! for a given stellar mass profile mstar and temperature tem (both as arrays),
! then rescale rho so that (M_* + M_gas)/M_tot = fb_target at r_vir.
! Uses the grid, m_dm, vol, dr and jv from the main program.
! ---------------------------------------------------------------
subroutine solve_hse(mstar, tem, rho, mgas, rho0)
   real(dp), intent(in)  :: mstar(jmax), tem(jmax)
   real(dp), intent(out) :: rho(jmax), mgas(jmax), rho0
   real(dp) :: grav(jmax), lnrho(jmax), tmid, mg_target, scale
   integer  :: k
 
   grav(1) = 0.0_dp
   do k = 2, jmax
      grav(k) = G*(m_dm(k) + mstar(k))/r(k)**2         ! DM + stars
   end do
 
   lnrho(1) = log(1.0d-25)                             ! arbitrary start, rescaled below
   do k = 2, jmax
      tmid = 0.5_dp*(tem(k-1) + tem(k))                ! T at the wall r(k)
      lnrho(k) = lnrho(k-1) - dr*grav(k)*mu*m_p/(k_B*tmid) &
                 - (log(tem(k)) - log(tem(k-1)))
   end do
   rho = exp(lnrho)
 
   mgas(1) = 0.0_dp
   do k = 2, jmax
      mgas(k) = mgas(k-1) + rho(k-1)*vol(k)
   end do
 
   ! (M_* + M_gas) = fb (M_DM + M_* + M_gas)  ->  M_gas = fb/(1-fb) M_DM - M_*
   mg_target = fb_target/(1.0_dp - fb_target)*m_dm(jv) - mstar(jv)
   if (mg_target <= 0.0_dp) stop 'target gas mass is not positive'
   scale = mg_target/mgas(jv)
 
   rho  = rho*scale
   mgas = mgas*scale
   rho0 = 1.0d-25*scale                                ! = rho(1)
end subroutine solve_hse
 
! baryon fraction at r_vir for a given model
real(dp) function fbr_at(mstar, mgas)
   real(dp), intent(in) :: mstar(jmax), mgas(jmax)
   fbr_at = (mstar(jv) + mgas(jv))/(m_dm(jv) + mstar(jv) + mgas(jv))
end function fbr_at
 
end program project1
